{
  "manifest_version": 3,
  "name": "ff-aws-okta-containers spike",
  "version": "0.0.1",
  "description": "Throwaway spike for IMPL-0001. Not for general use.",
  "browser_specific_settings": {
    "gecko": {
      "id": "spike@ff-aws-okta-containers",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "permissions": [
    "contextualIdentities",
    "cookies",
    "tabs"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_title": "Spike: open example.com in the test container"
  }
}
